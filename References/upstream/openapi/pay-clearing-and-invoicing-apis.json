"type":"string"}}},"examples":{"200 - OK":{"summary":"Success","value":{"request":{"result":"1"},"result":"CLEARING-20257716259"}},"200 - Invalid amount":{"summary":"Invalid amount","value":{"request":{"result":"0","errorId":"422","errorMessage":"Invalid amount [5,00], available amount is [1,47]"}}}}}}}}}}},"security":[{"basicAuth":[]}]}