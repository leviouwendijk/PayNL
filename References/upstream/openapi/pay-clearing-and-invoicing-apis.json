{"openapi":"3.0.1","info":{"title":"PAY. GLOBAL MANAEMENT SYSTEM API'S","description":"API endpoints for adding invoices and clearings via PAY.nl.","version":"1.0.0"},"servers":[{"url":"https://rest-api.pay.nl"}],"components":{"securitySchemes":{"basicAuth":{"type":"http","scheme":"basic"}}},"tags":[{"name":"Invoicing"},{"name":"Clearing"}],"paths":{"/v8/Alliance/addInvoice/json":{"post":{"tags":["Invoicing"],"summary":"Merchant:AddInvoice","description":"Use this endpoint to add an invoice for a merchant. This invoice can contain platform and transaction costs that you want to invoice to your sub-merchant. The invoice amount will be deducted from the balance of the sub-merchant and will be added to your balance.","security":[{"basicAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"serviceId":{"type":"string","description":"The serviceId of the partner (alliance) on which the payment should be booked."},"merchantId":{"type":"string","description":"The merchantId of the (sub)merchant to invoice."},"invoiceId":{"type":"string","description":"The ID of your invoice."},"amount":{"type":"integer","description":"The amount in cents."},"description":{"type":"string","description":"The payment description."},"invoiceUrl":{"type":"string","description":"A URL pointing to the location of the invoice."},"makeYesterday":{"type":"boolean","description":"Whether the transaction should be backdated to yesterday 23:59:59."},"extra1":{"type":"string","description":"The first free value."},"extra2":{"type":"string","description":"The second free value."},"extra3":{"type":"string","description":"The third free value."},"merchantServiceId":{"type":"string","description":"The service ID of the (sub)merchant to invoice."}},"required":["serviceId","merchantId","invoiceId","amount","description"]},"example":{"serviceId":"SL-0123-4567","merchantId":"M-8901-2345","invoiceId":"INV-20250711-001","amount":2500,"description":"Consul